---
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import SkillsSection from './skills/SkillBsdge.astro';
import { getCollection } from 'astro:content';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const publicRepo = t('projects.visibility.public');
const privateRepo = t('projects.visibility.private');
const earlyProject = t('projects.early.project');
const recentProject = t('projects.recent.project');

const entries = await getCollection('projects');
const projects = entries
  .sort((a, b) => a.data.order - b.data.order)
  .map(( { data } ) => ({ ...data, description: t(data.descriptionKey) }));
---

<section id="projects" class="py-32 px-8 bg-surface-container-low/20">
    <SkillsSection />
  <div class="max-w-7xl mx-auto mt-32">
    <div class="mb-16">
      <h2 class="font-headline text-4xl font-extrabold mb-4">{t('projects.heading')}</h2>
      <p class="text-slate-500">{t('projects.description')}</p>
    </div>

    <div id="projects-carousel" class="projects-carousel grid grid-cols-1 gap-6 md:grid-cols-2 lg:flex lg:overflow-x-auto lg:scroll-smooth lg:snap-x lg:snap-mandatory lg:pb-2">
      {projects.map((project) => (
        <article class="project-card group w-full overflow-hidden rounded-xl border border-white/5 bg-surface-container-low shadow-xl shadow-black/20 reveal lg:w-[48%] lg:shrink-0 lg:snap-start relative">
          {/* configuración para capa dependiendo del valor de isReady */}

          {!project.isReady && (
              <div class="absolute inset-0 z-10 flex items-center justify-center bg-black/60">
                <span class="rounded-full bg-black/70 px-6 py-3 text-xl font-bold text-white uppercase">
                    {t('projects.comingSoon')}
                </span>
              </div>
          )}

          <div class="h-64 overflow-hidden">
            <img src={project.image} alt={project.title} class="project-image h-full w-full object-cover transition-transform duration-700" loading="lazy" referrerpolicy="no-referrer" />
          </div>

          <div class="p-8">
            <div class="flex justify-between">
              <h3 class="mb-4 font-headline text-2xl font-bold text-white">{project.title}</h3>
              <div class="flex items-center gap-1.5">
                <span class="px-3 py-1 h-8 rounded-full border border-emerald-500/20 font-light text-emerald-500 bg-emerald-500/10 text-sm tracking-wider">{project.isPublic ? publicRepo : privateRepo}</span>
                <span class="px-3 py-1 h-8 rounded-full border border-[#4C3F78] font-light text-[#C4B5FD] bg-[#2B2545] text-sm tracking-wider">{project.isEarlyProject ? earlyProject : recentProject}</span>
              </div>
            </div>
            <p class="mb-8 leading-relaxed text-slate-400">{project.description}</p>

            <div class="mb-8">
              <ul class="mb-4 flex flex-row flex-wrap gap-x-2 gap-y-2">
                {(project.technologies ?? []).map((tag) => (
                  <li>
                    <span class={'flex gap-x-2 rounded-full px-2 py-1 text-xs ' + tag.color}>
                      <img src={tag.svg} alt={tag.name} class="size-4" loading="lazy" />
                      {tag.name}
                    </span>
                  </li>
                ))}
              </ul>
            </div>

            {project.repository && (
              <div class="flex items-center justify-between border-t border-white/5 pt-6">
                {project.demoUrl ? (
                  <a class="flex items-center gap-2 text-sm font-semibold hover:text-primary-custom transition-colors text-white" href={project.demoUrl} target="_blank" rel="noopener noreferrer">
                    {t('projects.demo')}
                  </a>
                ) : null}
                <a href={project.repository} class="flex items-center gap-2 text-sm font-semibold text-slate-500 transition-colors hover:text-white">
                  {t('projects.repository')}
                </a>
              </div>
            )}
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
