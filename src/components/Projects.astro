---
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const publicRepo = t('projects.visibility.public');
const privateRepo = t('projects.visibility.private');

const technologies = [
  { name: 'Sass', svg: '/shared/resources/logos/technologies/sass.svg', color: 'bg-black text-white' },
  { name: 'Css', svg: '/shared/resources/logos/technologies/css.svg', color: 'bg-[#1572B6] text-white' },
  { name: 'Bootstrap', svg: '/shared/resources/logos/technologies/bootstrap.svg', color: 'bg-[#563D7C] text-[#73bcf6]' },
  { name: 'JavaScript', svg: '/shared/resources/logos/technologies/javascript.svg', color: 'bg-[#F7DF1E] text-black' },
  { name: 'CSharp', svg: '/shared/resources/logos/technologies/csharp.svg', color: 'bg-[#68217A] text-white' },
];

const projects = [
  {
    title: 'Mercado Verde',
    description: t('projects.items.0.description'),
    repository: 'https://github.com/Axus00/MercadoVerde',
    span: t('projects.repository'),
    image: '/shared/resources/images/mercado-verde.webp',
    technologies,
    isPublic: true,
  },
  {
    title: 'La Misericordia',
    description: t('projects.items.1.description'),
    repository: 'https://github.com/Axus00/LaMisericordia',
    span: t('projects.repository'),
    image: '/shared/resources/images/la-misericordia.webp',
    technologies: [
      { name: 'C#', svg: '/shared/resources/logos/technologies/csharp.svg', color: 'bg-[#68217A] text-white' },
      { name: 'Css', svg: '/shared/resources/logos/technologies/css.svg', color: 'bg-[#1572B6] text-white' },
      { name: 'JavaScript', svg: '/shared/resources/logos/technologies/javascript.svg', color: 'bg-[#F7DF1E] text-black' },
    ],
    isPublic: true,
  },
  {
    title: 'Gift App',
    description: t('projects.items.2.description'),
    repository: 'https://github.com/Axus00/gift-app',
    span: t('projects.repository'),
    image: '/shared/resources/images/gift-app.png',
    technologies: [
      { name: 'TypeScript', svg: '/shared/resources/logos/technologies/typescript.svg', color: 'bg-[#3178C6] text-white' },
      { name: 'Vite', svg: '/shared/resources/logos/technologies/vite.svg', color: 'bg-[#370A7F] text-white' },
    ],
    isPublic: true,
  },
  {
    title: 'LLM Agent',
    description: t('projects.items.3.description'),
    image: '/shared/resources/images/llm-agent-langchain.webp',
    technologies: [
      { name: 'Python', svg: '/shared/resources/logos/technologies/python.svg', color: 'bg-[#FFDF76] text-black' },
      { name: 'LangChain', svg: '/shared/resources/logos/technologies/langchain.svg', color: 'bg-white text-black' },
      { name: 'Pydantic Logfire', svg: '/shared/resources/logos/technologies/pydantic.svg', color: 'bg-white text-black' },
    ],
    isPublic: false,
  },
];
---

<section id="projects" class="py-32 px-8 bg-surface-container-low/20">
  <div class="max-w-7xl mx-auto">
    <div class="mb-16">
      <h2 class="font-headline text-4xl font-extrabold mb-4">{t('projects.heading')}</h2>
      <p class="text-slate-500">{t('projects.description')}</p>
    </div>

    <div id="projects-carousel" class="projects-carousel grid grid-cols-1 gap-6 md:grid-cols-2 lg:flex lg:overflow-x-auto lg:scroll-smooth lg:snap-x lg:snap-mandatory lg:pb-2">
      {projects.map((project) => (
        <article class="project-card group relative w-full overflow-hidden rounded-xl border border-white/5 bg-surface-container-low shadow-xl shadow-black/20 reveal lg:w-[48%] lg:shrink-0 lg:snap-start">
          <div class="h-64 overflow-hidden">
            <img src={project.image} alt={project.title} class="project-image h-full w-full object-cover transition-transform duration-700" loading="lazy" referrerpolicy="no-referrer" />
          </div>

          <div class="p-8">
            <div class="flex justify-between">
              <h3 class="mb-4 font-headline text-2xl font-bold text-white">{project.title}</h3>
              <span class="px-3 py-1 h-8 rounded-full border border-emerald-500/20 font-light text-emerald-500 bg-emerald-500/10 text-sm tracking-wider">{project.isPublic ? publicRepo : privateRepo}</span>
            </div>
            <p class="mb-8 leading-relaxed text-slate-400">{project.description}</p>

            <div class="mb-8">
              <ul class="mb-4 flex flex-row flex-wrap gap-x-2 gap-y-2">
                {(project.technologies ?? []).map((tag) => (
                  <li>
                    <span class={'flex gap-x-2 rounded-full px-2 py-1 text-xs ' + tag.color}>
                      <img src={tag.svg} alt={tag.name} class="size-4" loading="lazy" />
                      {tag.name}
                    </span>
                  </li>
                ))}
              </ul>
            </div>

            {project.repository && (
              <div class="flex items-center justify-between border-t border-white/5 pt-6">
                <button class="flex items-center gap-2 text-sm font-semibold hover:text-primary-custom transition-colors text-white" hidden>
                  Demo en vivo
                </button>
                <a href={project.repository} class="flex items-center gap-2 text-sm font-semibold text-slate-500 transition-colors hover:text-white">
                  {project.span}
                </a>
              </div>
            )}
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
