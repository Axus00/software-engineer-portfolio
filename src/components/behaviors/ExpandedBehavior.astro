---
import { getLangFromUrl, useTranslations } from "../../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const closeLabel = t("messages.items.action");
---

<script is:inline define:vars={{ closeLabel }}>
    const dots = document.querySelectorAll(".dots");

    dots.forEach(dot => {
        dot.addEventListener("click", (e) => {
            if(!(e.target instanceof Element)) return;

            const btn = e.target.closest(".dots");
            if(!btn) return;

            const p = e.target.closest(".message");
            if(!p) return;

            const textEl = p.querySelector(".message-text");
            if(!textEl) return;

            const full = p.dataset.full || "";
            const short = p.dataset.short || "";

            const expanded = p.dataset.expanded === "true";

            if(!expanded) {
                textEl.textContent = full;
                btn.classList.add("text-xs");
                btn.textContent = closeLabel;
                p.dataset.expanded = "true";
            } else {
                textEl.textContent = short;
                btn.textContent = "...";
                p.dataset.expanded = "false";
            }
        });
    });
</script>
