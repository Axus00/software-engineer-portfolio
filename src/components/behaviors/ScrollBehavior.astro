<script>
    const nav = document.getElementById('main-nav');
    const spine = document.getElementById('spine-progress');
    const expSpine = document.getElementById('experience-progress');

    const onScroll = () => {
      const y = window.scrollY || 0;
      if (nav) {
        const scrolled = y > 50;
        nav.classList.toggle('glass-nav', scrolled);
        nav.classList.toggle('shadow-2xl', scrolled);
        nav.classList.toggle('py-3', scrolled);
        nav.classList.toggle('px-6', scrolled);
        nav.classList.toggle('py-4', !scrolled);
        nav.classList.toggle('px-2', !scrolled);
      }

      const h = document.documentElement;
      const max = h.scrollHeight - h.clientHeight;
      const ratio = max > 0 ? y / max : 0;
      if (spine) spine.style.scale = `1 ${Math.min(1, Math.max(0, ratio))}`;

      const exp = document.getElementById('experience');
      if (expSpine && exp) {
        const rect = exp.getBoundingClientRect();
        const vh = window.innerHeight;
        const progress = (vh - rect.top) / (rect.height + vh * 0.3);
        expSpine.style.scale = `1 ${Math.min(1, Math.max(0, progress))}`;
      }
    };

    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
          }
        }
      },
      { threshold: 0.15 }
    );

    document.querySelectorAll('.reveal').forEach((el) => observer.observe(el));
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll, { passive: true });
    window.addEventListener('load', onScroll, { once: true });
    onScroll();
</script>