---
import { getLangFromUrl, useTranslations } from '../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<aside aria-label={t('blog.onThisPage')} class="hidden self-start xl:sticky xl:top-32 xl:block">
  <p class="font-mono text-[0.68rem] uppercase tracking-[0.12em] text-slate-500">{t('blog.onThisPage')}</p>
  <nav class="mt-3 border-l border-white/10">
    <a href="#introduction" class="block border-l border-primary-custom py-1 pl-4 text-sm text-slate-200 transition-colors hover:text-primary-custom">{t('blog.introduction')}</a>
    <a href="#articles" class="block py-1 pl-4 text-sm text-slate-400 transition-colors hover:text-slate-100">{t('blog.articles')}</a>
  </nav>
</aside>
