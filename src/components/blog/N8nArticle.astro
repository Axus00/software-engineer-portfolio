---
import { getLangFromUrl, useTranslations } from '../../i18n/utils';
import CopyCodeBehavior from '../behaviors/CopyCodeBehavior.astro';
import TerminalBlock from './TerminalBlock.astro';
import './NifiArticle.css';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const blogPath = lang === 'es' ? '/blog' : '/en/blog';

const sources = [
  { label: t('n8n.sources.docs'), href: 'https://docs.n8n.io/', tone: 'green' },
  { label: t('n8n.sources.manualTrigger'), href: 'https://docs.n8n.io/integrations/builtin/core-nodes/n8n-nodes-base.manualworkflowtrigger/', tone: 'violet' },
  { label: t('n8n.sources.editFields'), href: 'https://docs.n8n.io/integrations/builtin/core-nodes/n8n-nodes-base.set/', tone: 'blue' },
  { label: t('n8n.sources.switch'), href: 'https://docs.n8n.io/integrations/builtin/core-nodes/n8n-nodes-base.switch/', tone: 'amber' },
  { label: t('n8n.sources.expressions'), href: 'https://docs.n8n.io/build/work-with-data/expressions-versus-data-nodes', tone: 'rose' },
  { label: t('n8n.sources.executions'), href: 'https://docs.n8n.io/build/understand-workflows/understand-executions', tone: 'cyan' },
  { label: t('n8n.sources.docker'), href: 'https://docs.n8n.io/deploy/host-n8n/install-options/install-with-docker', tone: 'slate' },
];

const toneClass = {
  green: 'border-secondary-custom/25 bg-secondary-custom/[0.07] text-secondary-custom hover:bg-secondary-custom/[0.13]',
  violet: 'border-primary-custom/25 bg-primary-custom/[0.07] text-primary-custom hover:bg-primary-custom/[0.13]',
  blue: 'border-sky-400/25 bg-sky-400/[0.07] text-sky-300 hover:bg-sky-400/[0.13]',
  amber: 'border-amber-400/25 bg-amber-400/[0.07] text-amber-300 hover:bg-amber-400/[0.13]',
  rose: 'border-rose-400/25 bg-rose-400/[0.07] text-rose-300 hover:bg-rose-400/[0.13]',
  cyan: 'border-cyan-400/25 bg-cyan-400/[0.07] text-cyan-300 hover:bg-cyan-400/[0.13]',
  slate: 'border-white/15 bg-white/[0.04] text-slate-300 hover:bg-white/[0.08]',
};

const fields = {
  firstName: t('n8n.fields.firstName'),
  lastName: t('n8n.fields.lastName'),
  email: t('n8n.fields.email'),
  age: t('n8n.fields.age'),
  message: t('n8n.fields.message'),
};
const expression = (field: string) => `{{ $json.${field} }}`;

const npxStart = `npx n8n`;
const dockerStart = `docker volume create n8n_data

docker run -it --rm --name n8n \\
  -p 5678:5678 \\
  -v n8n_data:/home/node/.n8n \\
  docker.n8n.io/n8nio/n8n`;

const userJson = JSON.stringify({
  [fields.firstName]: t('n8n.sample.firstName'),
  [fields.lastName]: t('n8n.sample.lastName'),
  [fields.email]: 'laura.martinez@example.com',
  [fields.age]: 21,
}, null, 2);

const mappedFields = [
  { name: fields.firstName, type: 'String' },
  { name: fields.lastName, type: 'String' },
  { name: fields.email, type: 'String' },
  { name: fields.age, type: 'Number' },
];

const branches = [
  { label: t('n8n.tutorial.branchTrue'), message: t('n8n.tutorial.messageTrue'), tone: 'border-secondary-custom/25 bg-secondary-custom/[0.06]', accent: 'text-secondary-custom' },
  { label: t('n8n.tutorial.branchFalse'), message: t('n8n.tutorial.messageFalse'), tone: 'border-amber-400/25 bg-amber-400/[0.055]', accent: 'text-amber-300' },
];
---

<article class="mx-auto w-full max-w-7xl px-5 pb-20 pt-28 sm:px-8 lg:pt-32">
  <a href={blogPath} class="inline-flex items-center gap-2 text-sm text-slate-400 transition hover:text-secondary-custom focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-secondary-custom">
    <span aria-hidden="true">←</span> {t('n8n.backToBlog')}
  </a>

  <header class="relative mt-8 overflow-hidden rounded-[2rem] border border-white/10 bg-surface-container-low px-6 py-10 sm:px-10 sm:py-14 lg:px-14 lg:py-16">
    <div class="pointer-events-none absolute inset-0 opacity-70" aria-hidden="true">
      <div class="absolute -right-24 -top-32 h-80 w-80 rounded-full bg-primary-custom/10 blur-3xl"></div>
      <div class="absolute -bottom-32 left-1/3 h-72 w-72 rounded-full bg-secondary-custom/10 blur-3xl"></div>
      <div class="article-grid absolute inset-0 opacity-30"></div>
    </div>
    <div class="relative grid items-center gap-10 lg:grid-cols-[minmax(0,1.2fr)_minmax(300px,.8fr)]">
      <div>
        <div class="flex flex-wrap items-center gap-3 font-mono text-[0.68rem] uppercase tracking-[0.12em]">
          <span class="rounded-full border border-secondary-custom/25 bg-secondary-custom/10 px-3 py-1.5 text-secondary-custom">n8n</span>
          <span class="text-slate-500">8 {t('n8n.readTime')}</span>
        </div>
        <h1 class="mt-6 max-w-4xl font-headline text-4xl font-extrabold leading-[1.05] tracking-tight text-slate-100 sm:text-5xl lg:text-6xl">
          {t('n8n.title')} <span class="text-gradient">{t('n8n.titleHighlight')}</span>
        </h1>
        <p class="mt-6 max-w-3xl text-base leading-8 text-slate-400 sm:text-lg">{t('n8n.lead')}</p>
        <div class="mt-7 flex flex-wrap items-center gap-3 text-xs text-slate-500">
          <span>{t('n8n.published')}</span><span aria-hidden="true">•</span><span>{t('n8n.updated')}</span>
        </div>
      </div>

      <div class="relative mx-auto w-full max-w-md" role="img" aria-label={t('n8n.flowDiagram')}>
        <div class="rounded-3xl border border-white/10 bg-[#0b0f15]/90 p-5 shadow-2xl shadow-black/30">
          <div class="mb-5 flex items-center justify-between">
            <span class="font-mono text-[0.65rem] uppercase tracking-[0.14em] text-slate-500">workflow.json</span>
            <span class="h-2 w-2 animate-pulse rounded-full bg-secondary-custom shadow-[0_0_16px_rgba(64,229,108,.8)]"></span>
          </div>
          <div class="flex flex-col items-center gap-3 sm:flex-row sm:justify-between sm:gap-2">
            <div class="flow-node border-sky-400/25 text-sky-300"><span>01</span> Trigger</div>
            <div class="flow-arrow" aria-hidden="true">↓</div>
            <div class="flow-node border-primary-custom/25 text-primary-custom"><span>02</span> JSON</div>
            <div class="flow-arrow" aria-hidden="true">↓</div>
            <div class="flow-node border-primary-custom/25 text-primary-custom"><span>03</span> Fields</div>
          </div>
          <div class="mt-3 flex flex-col items-center gap-3">
            <div class="text-slate-600" aria-hidden="true">↓</div>
            <div class="flow-node border-cyan-400/25 text-cyan-300"><span>04</span> Switch · {fields.age}</div>
          </div>
          <div class="mt-3 grid grid-cols-2 gap-2">
            <div class="flow-node border-secondary-custom/25 text-secondary-custom"><span>true</span> ≥ 18</div>
            <div class="flow-node border-amber-400/25 text-amber-300"><span>false</span> &lt; 18</div>
          </div>
          <div class="mt-5 grid grid-cols-3 gap-2 border-t border-white/10 pt-4 text-center font-mono text-[0.6rem] uppercase tracking-[0.08em] text-slate-500">
            <span>trigger</span><span>map</span><span>route</span>
          </div>
        </div>
      </div>
    </div>
  </header>

  <nav aria-label={t('n8n.onThisPage')} class="mt-6 overflow-x-auto rounded-2xl border border-white/10 bg-white/[0.025] p-2 lg:hidden">
    <div class="flex min-w-max gap-1">
      <a class="toc-pill" href="#what-is-n8n">01 {t('n8n.nav.what')}</a>
      <a class="toc-pill" href="#use-cases">02 {t('n8n.nav.useCases')}</a>
      <a class="toc-pill" href="#start">03 {t('n8n.nav.start')}</a>
      <a class="toc-pill" href="#tutorial">04 {t('n8n.nav.tutorial')}</a>
      <a class="toc-pill" href="#traceability">05 {t('n8n.nav.traceability')}</a>
    </div>
  </nav>

  <div class="mt-12 grid gap-12 lg:grid-cols-[minmax(0,1fr)_230px] xl:gap-16">
    <div class="min-w-0 space-y-20">
      <section id="what-is-n8n" class="article-section">
        <p class="section-index">01 · {t('n8n.nav.what')}</p>
        <h2>{t('n8n.what.title')}</h2>
        <p>{t('n8n.what.p1')}</p>
        <p>{t('n8n.what.p2')}</p>

        <div class="mt-8 grid gap-4 sm:grid-cols-3">
          <div class="concept-card"><span>01</span><h3>Trigger</h3><p>{t('n8n.what.trigger')}</p></div>
          <div class="concept-card"><span>02</span><h3>{t('n8n.what.nodeTitle')}</h3><p>{t('n8n.what.node')}</p></div>
          <div class="concept-card"><span>03</span><h3>{t('n8n.what.executionTitle')}</h3><p>{t('n8n.what.execution')}</p></div>
        </div>

        <div class="callout mt-8">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><path d="M12 11v5M12 8h.01"></path></svg>
          <div><h3>{t('n8n.what.calloutTitle')}</h3><p>{t('n8n.what.callout')}</p></div>
        </div>
      </section>

      <section id="use-cases" class="article-section">
        <p class="section-index">02 · {t('n8n.nav.useCases')}</p>
        <h2>{t('n8n.useCases.title')}</h2>
        <p>{t('n8n.useCases.p1')}</p>
        <div class="mt-8 grid gap-4 sm:grid-cols-2">
          <div class="check-card"><span>✓</span><div><h3>{t('n8n.useCases.integrationTitle')}</h3><p>{t('n8n.useCases.integration')}</p></div></div>
          <div class="check-card"><span>✓</span><div><h3>{t('n8n.useCases.opsTitle')}</h3><p>{t('n8n.useCases.ops')}</p></div></div>
          <div class="check-card"><span>✓</span><div><h3>{t('n8n.useCases.aiTitle')}</h3><p>{t('n8n.useCases.ai')}</p></div></div>
          <div class="check-card"><span>✓</span><div><h3>{t('n8n.useCases.dataTitle')}</h3><p>{t('n8n.useCases.data')}</p></div></div>
        </div>
      </section>

      <section id="start" class="article-section">
        <p class="section-index">03 · {t('n8n.nav.start')}</p>
        <h2>{t('n8n.start.title')}</h2>
        <p>{t('n8n.start.p1')}</p>
        <div class="mt-7"><TerminalBlock command={npxStart} label={t('n8n.terminal.npx')} copyLabel={t('n8n.copy')} copiedLabel={t('n8n.copied')} /></div>
        <p>{t('n8n.start.p2')}</p>
        <div class="mt-7"><TerminalBlock command={dockerStart} label={t('n8n.terminal.docker')} copyLabel={t('n8n.copy')} copiedLabel={t('n8n.copied')} /></div>
        <div class="callout mt-8 callout-warning">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M12 3 2.8 19h18.4L12 3Z"></path><path d="M12 9v4M12 16h.01"></path></svg>
          <div><h3>{t('n8n.start.noteTitle')}</h3><p>{t('n8n.start.note')}</p></div>
        </div>
      </section>

      <section id="tutorial" class="article-section">
        <p class="section-index">04 · {t('n8n.nav.tutorial')}</p>
        <h2>{t('n8n.tutorial.title')}</h2>
        <p>{t('n8n.tutorial.p1')}</p>

        <ol class="mt-8 space-y-6">
          <li class="step"><span>1</span><div class="min-w-0 flex-1"><h3>{t('n8n.tutorial.step1Title')}</h3><p>{t('n8n.tutorial.step1')}</p></div></li>

          <li class="step"><span>2</span><div class="min-w-0 flex-1">
            <h3>{t('n8n.tutorial.step2Title')}</h3><p>{t('n8n.tutorial.step2')}</p>
            <div class="mt-5"><TerminalBlock command={userJson} label={t('n8n.terminal.json')} copyLabel={t('n8n.copy')} copiedLabel={t('n8n.copied')} /></div>
          </div></li>

          <li class="step"><span>3</span><div class="min-w-0 flex-1">
            <h3>{t('n8n.tutorial.step3Title')}</h3><p>{t('n8n.tutorial.step3')}</p>
            <div class="mt-5 overflow-hidden rounded-2xl border border-white/10">
              <div class="bg-white/[0.04] px-4 py-3 font-mono text-[0.65rem] uppercase tracking-[0.1em] text-slate-500 sm:px-5">{t('n8n.tutorial.fieldsLabel')}</div>
              {mappedFields.map((field) => (
                <div class="config-row"><code>{field.name} <span class="text-slate-500">· {field.type}</span></code><span class="font-mono">{expression(field.name)}</span></div>
              ))}
            </div>
            <p class="mt-4!">{t('n8n.tutorial.fieldsNote')}</p>
          </div></li>

          <li class="step"><span>4</span><div class="min-w-0 flex-1">
            <h3>{t('n8n.tutorial.step4Title')}</h3><p>{t('n8n.tutorial.step4')}</p>
            <div class="mt-5 overflow-hidden rounded-2xl border border-white/10">
              <div class="grid grid-cols-[minmax(0,.75fr)_minmax(0,1.25fr)] gap-4 bg-white/[0.04] px-4 py-3 font-mono text-[0.65rem] uppercase tracking-[0.1em] text-slate-500 sm:px-5">
                <span>{t('n8n.tutorial.property')}</span><span>{t('n8n.tutorial.value')}</span>
              </div>
              <div class="config-row"><code>Mode</code><span>Rules</span></div>
              <div class="config-row"><code>{t('n8n.tutorial.rule1')}</code><span><span class="font-mono">{expression(fields.age)}</span> · {t('n8n.tutorial.rule1Value')}</span></div>
              <div class="config-row"><code>{t('n8n.tutorial.rule2')}</code><span><span class="font-mono">{expression(fields.age)}</span> · {t('n8n.tutorial.rule2Value')}</span></div>
              <div class="config-row"><code>Rename Output</code><span>true / false</span></div>
            </div>
            <p class="mt-4!">{t('n8n.tutorial.switchNote')}</p>
          </div></li>

          <li class="step"><span>5</span><div class="min-w-0 flex-1">
            <h3>{t('n8n.tutorial.step5Title')}</h3><p>{t('n8n.tutorial.step5')}</p>
            <div class="mt-5 grid gap-4 sm:grid-cols-2">
              {branches.map((branch) => (
                <div class:list={['rounded-2xl border p-5', branch.tone]}>
                  <p class:list={['font-mono text-[0.68rem] uppercase tracking-[0.12em]', branch.accent]}>{branch.label}</p>
                  <code class="mt-3 block font-mono text-sm leading-6 text-slate-200 [overflow-wrap:anywhere]">{fields.message} = {expression(fields.firstName)} {branch.message}</code>
                </div>
              ))}
            </div>
          </div></li>
        </ol>
      </section>

      <section id="traceability" class="article-section">
        <p class="section-index">05 · {t('n8n.nav.traceability')}</p>
        <h2>{t('n8n.trace.title')}</h2>
        <p>{t('n8n.trace.p1')}</p>
        <div class="mt-8 grid gap-4 sm:grid-cols-2">
          <div class="check-card"><span aria-hidden="true">1</span><div><h3>{t('n8n.trace.canvasTitle')}</h3><p>{t('n8n.trace.canvas')}</p></div></div>
          <div class="check-card"><span aria-hidden="true">2</span><div><h3>{t('n8n.trace.ioTitle')}</h3><p>{t('n8n.trace.io')}</p></div></div>
          <div class="check-card"><span aria-hidden="true">3</span><div><h3>{t('n8n.trace.executionsTitle')}</h3><p>{t('n8n.trace.executions')}</p></div></div>
          <div class="check-card"><span aria-hidden="true">4</span><div><h3>{t('n8n.trace.experimentTitle')}</h3><p>{t('n8n.trace.experiment')}</p></div></div>
        </div>
        <div class="callout mt-8">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M4 6h16M4 12h10M4 18h7"></path></svg>
          <div><h3>{t('n8n.trace.calloutTitle')}</h3><p>{t('n8n.trace.callout')}</p></div>
        </div>
        <div class="mt-10 rounded-3xl border border-primary-custom/20 bg-primary-custom/[0.06] p-6 sm:p-8">
          <p class="font-headline text-xl font-bold text-slate-100">{t('n8n.conclusion.title')}</p>
          <p class="mt-3 text-sm leading-7 text-slate-400 sm:text-base">{t('n8n.conclusion.p1')}</p>
        </div>
      </section>

      <section aria-labelledby="sources-heading" class="border-t border-white/10 pt-10">
        <p class="section-index">{t('n8n.sources.eyebrow')}</p>
        <h2 id="sources-heading" class="mt-3 font-headline text-2xl font-bold text-slate-100">{t('n8n.sources.title')}</h2>
        <p class="mt-3 text-sm leading-7 text-slate-500">{t('n8n.sources.description')}</p>
        <div class="mt-6 flex flex-wrap gap-3">
          {sources.map((source) => (
            <a href={source.href} target="_blank" rel="noreferrer" class:list={['source-badge', toneClass[source.tone as keyof typeof toneClass]]}>
              <span class="h-1.5 w-1.5 rounded-full bg-current" aria-hidden="true"></span>
              {source.label}
              <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M14 5h5v5M10 14 19 5M19 14v5H5V5h5"></path></svg>
              <span class="sr-only"> ({t('n8n.sources.newTab')})</span>
            </a>
          ))}
        </div>
      </section>
    </div>

    <aside class="hidden self-start lg:sticky lg:top-28 lg:block" aria-label={t('n8n.onThisPage')}>
      <p class="font-mono text-[0.66rem] uppercase tracking-[0.12em] text-slate-500">{t('n8n.onThisPage')}</p>
      <nav class="mt-4 border-l border-white/10">
        <a class="side-link" href="#what-is-n8n">01 · {t('n8n.nav.what')}</a>
        <a class="side-link" href="#use-cases">02 · {t('n8n.nav.useCases')}</a>
        <a class="side-link" href="#start">03 · {t('n8n.nav.start')}</a>
        <a class="side-link" href="#tutorial">04 · {t('n8n.nav.tutorial')}</a>
        <a class="side-link" href="#traceability">05 · {t('n8n.nav.traceability')}</a>
      </nav>
      <div class="mt-8 rounded-2xl border border-white/10 bg-white/[0.025] p-4">
        <p class="font-mono text-[0.64rem] uppercase tracking-[0.1em] text-slate-500">{t('n8n.stack')}</p>
        <div class="mt-3 flex flex-wrap gap-2">
          <span class="mini-badge">n8n</span><span class="mini-badge">Edit Fields</span><span class="mini-badge">Switch</span>
        </div>
      </div>
    </aside>
  </div>
</article>

<CopyCodeBehavior />
