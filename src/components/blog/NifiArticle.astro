---
import { getLangFromUrl, useTranslations } from '../../i18n/utils';
import CopyCodeBehavior from '../behaviors/CopyCodeBehavior.astro';
import TerminalBlock from './TerminalBlock.astro';
import './NifiArticle.css';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const blogPath = lang === 'es' ? '/blog' : '/en/blog';

const sources = [
  { label: t('nifi.sources.gettingStarted'), href: 'https://nifi.apache.org/nifi-docs/getting-started.html', tone: 'green' },
  { label: t('nifi.sources.userGuide'), href: 'https://nifi.apache.org/nifi-docs/user-guide.html', tone: 'violet' },
  { label: t('nifi.sources.expressionLanguage'), href: 'https://nifi.apache.org/nifi-docs/expression-language-guide.html', tone: 'blue' },
  { label: t('nifi.sources.recordPath'), href: 'https://nifi.apache.org/nifi-docs/record-path-guide.html', tone: 'amber' },
  { label: t('nifi.sources.publishKafka'), href: 'https://nifi.apache.org/components/org.apache.nifi.kafka.processors.PublishKafka/', tone: 'rose' },
  { label: t('nifi.sources.consumeKafka'), href: 'https://nifi.apache.org/components/org.apache.nifi.kafka.processors.ConsumeKafka/', tone: 'cyan' },
  { label: t('nifi.sources.kafkaQuickstart'), href: 'https://kafka.apache.org/quickstart/', tone: 'slate' },
];

const toneClass = {
  green: 'border-secondary-custom/25 bg-secondary-custom/[0.07] text-secondary-custom hover:bg-secondary-custom/[0.13]',
  violet: 'border-primary-custom/25 bg-primary-custom/[0.07] text-primary-custom hover:bg-primary-custom/[0.13]',
  blue: 'border-sky-400/25 bg-sky-400/[0.07] text-sky-300 hover:bg-sky-400/[0.13]',
  amber: 'border-amber-400/25 bg-amber-400/[0.07] text-amber-300 hover:bg-amber-400/[0.13]',
  rose: 'border-rose-400/25 bg-rose-400/[0.07] text-rose-300 hover:bg-rose-400/[0.13]',
  cyan: 'border-cyan-400/25 bg-cyan-400/[0.07] text-cyan-300 hover:bg-cyan-400/[0.13]',
  slate: 'border-white/15 bg-white/[0.04] text-slate-300 hover:bg-white/[0.08]',
};

const nifiStart = `# Linux / macOS
bin/nifi.sh start --wait-for-init 120
bin/nifi.sh status

# Windows (PowerShell)
.\\bin\\nifi.cmd start
.\\bin\\nifi.cmd status`;

const credentials = `./bin/nifi.sh set-single-user-credentials nifi-admin 'use-a-strong-password'`;
const kafkaStart = `docker pull apache/kafka:4.3.1
docker run --name kafka-local -p 9092:9092 -d apache/kafka:4.3.1`;
const kafkaTopic = `bin/kafka-topics.sh --create \\
  --topic nifi-events \\
  --bootstrap-server localhost:9092

bin/kafka-topics.sh --describe \\
  --topic nifi-events \\
  --bootstrap-server localhost:9092`;
---

<article class="mx-auto w-full max-w-7xl px-5 pb-20 pt-28 sm:px-8 lg:pt-32">
  <a href={blogPath} class="inline-flex items-center gap-2 text-sm text-slate-400 transition hover:text-secondary-custom focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-secondary-custom">
    <span aria-hidden="true">←</span> {t('nifi.backToBlog')}
  </a>

  <header class="relative mt-8 overflow-hidden rounded-[2rem] border border-white/10 bg-surface-container-low px-6 py-10 sm:px-10 sm:py-14 lg:px-14 lg:py-16">
    <div class="pointer-events-none absolute inset-0 opacity-70" aria-hidden="true">
      <div class="absolute -right-24 -top-32 h-80 w-80 rounded-full bg-primary-custom/10 blur-3xl"></div>
      <div class="absolute -bottom-32 left-1/3 h-72 w-72 rounded-full bg-secondary-custom/10 blur-3xl"></div>
      <div class="article-grid absolute inset-0 opacity-30"></div>
    </div>
    <div class="relative grid items-center gap-10 lg:grid-cols-[minmax(0,1.2fr)_minmax(300px,.8fr)]">
      <div>
        <div class="flex flex-wrap items-center gap-3 font-mono text-[0.68rem] uppercase tracking-[0.12em]">
          <span class="rounded-full border border-secondary-custom/25 bg-secondary-custom/10 px-3 py-1.5 text-secondary-custom">Apache NiFi</span>
          <span class="text-slate-500">12 {t('nifi.readTime')}</span>
        </div>
        <h1 class="mt-6 max-w-4xl font-headline text-4xl font-extrabold leading-[1.05] tracking-tight text-slate-100 sm:text-5xl lg:text-6xl">
          {t('nifi.title')} <span class="text-gradient">{t('nifi.titleHighlight')}</span>
        </h1>
        <p class="mt-6 max-w-3xl text-base leading-8 text-slate-400 sm:text-lg">{t('nifi.lead')}</p>
        <div class="mt-7 flex flex-wrap items-center gap-3 text-xs text-slate-500">
          <span>{t('nifi.published')}</span><span aria-hidden="true">•</span><span>{t('nifi.updated')}</span>
        </div>
      </div>

      <div class="relative mx-auto w-full max-w-md" aria-label={t('nifi.flowDiagram')}>
        <div class="rounded-3xl border border-white/10 bg-[#0b0f15]/90 p-5 shadow-2xl shadow-black/30">
          <div class="mb-5 flex items-center justify-between">
            <span class="font-mono text-[0.65rem] uppercase tracking-[0.14em] text-slate-500">dataflow.json</span>
            <span class="h-2 w-2 animate-pulse rounded-full bg-secondary-custom shadow-[0_0_16px_rgba(64,229,108,.8)]"></span>
          </div>
          <div class="flex flex-col items-center gap-3 sm:flex-row sm:justify-between sm:gap-2">
            <div class="flow-node border-sky-400/25 text-sky-300"><span>01</span> HTTP</div>
            <div class="flow-arrow" aria-hidden="true">↓</div>
            <div class="flow-node border-primary-custom/25 text-primary-custom"><span>02</span> NiFi</div>
            <div class="flow-arrow" aria-hidden="true">↓</div>
            <div class="flow-node border-secondary-custom/25 text-secondary-custom"><span>03</span> Kafka</div>
          </div>
          <div class="mt-5 grid grid-cols-3 gap-2 border-t border-white/10 pt-4 text-center font-mono text-[0.6rem] uppercase tracking-[0.08em] text-slate-500">
            <span>ingest</span><span>route</span><span>stream</span>
          </div>
        </div>
      </div>
    </div>
  </header>

  <nav aria-label={t('nifi.onThisPage')} class="mt-6 overflow-x-auto rounded-2xl border border-white/10 bg-white/[0.025] p-2 lg:hidden">
    <div class="flex min-w-max gap-1">
      <a class="toc-pill" href="#mental-model">01 {t('nifi.nav.model')}</a>
      <a class="toc-pill" href="#start">02 {t('nifi.nav.start')}</a>
      <a class="toc-pill" href="#flow">03 {t('nifi.nav.flow')}</a>
      <a class="toc-pill" href="#kafka">04 Kafka</a>
      <a class="toc-pill" href="#production">05 {t('nifi.nav.production')}</a>
    </div>
  </nav>

  <div class="mt-12 grid gap-12 lg:grid-cols-[minmax(0,1fr)_230px] xl:gap-16">
    <div class="min-w-0 space-y-20">
      <section id="mental-model" class="article-section">
        <p class="section-index">01 · {t('nifi.nav.model')}</p>
        <h2>{t('nifi.model.title')}</h2>
        <p>{t('nifi.model.p1')}</p>
        <p>{t('nifi.model.p2')}</p>

        <div class="mt-8 grid gap-4 sm:grid-cols-3">
          <div class="concept-card"><span>01</span><h3>FlowFile</h3><p>{t('nifi.model.flowfile')}</p></div>
          <div class="concept-card"><span>02</span><h3>Processor</h3><p>{t('nifi.model.processor')}</p></div>
          <div class="concept-card"><span>03</span><h3>Connection</h3><p>{t('nifi.model.connection')}</p></div>
        </div>

        <div class="callout mt-8">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><path d="M12 11v5M12 8h.01"></path></svg>
          <div><h3>{t('nifi.model.calloutTitle')}</h3><p>{t('nifi.model.callout')}</p></div>
        </div>
      </section>

      <section id="start" class="article-section">
        <p class="section-index">02 · {t('nifi.nav.start')}</p>
        <h2>{t('nifi.start.title')}</h2>
        <p>{t('nifi.start.p1')}</p>
        <div class="mt-7"><TerminalBlock command={nifiStart} label={t('nifi.terminal.service')} copyLabel={t('nifi.copy')} copiedLabel={t('nifi.copied')} /></div>
        <p>{t('nifi.start.p2')}</p>
        <div class="mt-7"><TerminalBlock command={credentials} label={t('nifi.terminal.security')} copyLabel={t('nifi.copy')} copiedLabel={t('nifi.copied')} /></div>
        <div class="callout mt-8 callout-warning">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M12 3 2.8 19h18.4L12 3Z"></path><path d="M12 9v4M12 16h.01"></path></svg>
          <div><h3>{t('nifi.start.securityTitle')}</h3><p>{t('nifi.start.security')}</p></div>
        </div>
      </section>

      <section id="flow" class="article-section">
        <p class="section-index">03 · {t('nifi.nav.flow')}</p>
        <h2>{t('nifi.flow.title')}</h2>
        <p>{t('nifi.flow.p1')}</p>
        <ol class="mt-8 space-y-4">
          <li class="step"><span>1</span><div><h3>{t('nifi.flow.step1Title')}</h3><p>{t('nifi.flow.step1')}</p></div></li>
          <li class="step"><span>2</span><div><h3>{t('nifi.flow.step2Title')}</h3><p>{t('nifi.flow.step2')}</p></div></li>
          <li class="step"><span>3</span><div><h3>{t('nifi.flow.step3Title')}</h3><p>{t('nifi.flow.step3')}</p></div></li>
          <li class="step"><span>4</span><div><h3>{t('nifi.flow.step4Title')}</h3><p>{t('nifi.flow.step4')}</p></div></li>
        </ol>
        <div class="mt-8 rounded-2xl border border-white/10 bg-white/[0.025] p-5 sm:p-6">
          <p class="font-mono text-[0.68rem] uppercase tracking-[0.12em] text-secondary-custom">NiFi Expression Language</p>
          <code class="mt-3 block overflow-x-auto font-mono text-sm text-slate-200">${'{filename:matches(".*\\.json"):and(${fileSize:lt(10485760)})}'}</code>
          <p class="mt-3 text-sm leading-6 text-slate-500">{t('nifi.flow.expression')}</p>
        </div>
      </section>

      <section id="kafka" class="article-section">
        <p class="section-index">04 · Apache Kafka</p>
        <h2>{t('nifi.kafka.title')}</h2>
        <p>{t('nifi.kafka.p1')}</p>
        <p>{t('nifi.kafka.p2')}</p>
        <div class="mt-7"><TerminalBlock command={kafkaStart} label="docker · kafka" copyLabel={t('nifi.copy')} copiedLabel={t('nifi.copied')} /></div>
        <div class="mt-5"><TerminalBlock command={kafkaTopic} label={t('nifi.terminal.topic')} copyLabel={t('nifi.copy')} copiedLabel={t('nifi.copied')} /></div>

        <div class="mt-8 overflow-hidden rounded-2xl border border-white/10">
          <div class="grid grid-cols-[minmax(0,.75fr)_minmax(0,1.25fr)] bg-white/[0.04] px-4 py-3 font-mono text-[0.65rem] uppercase tracking-[0.1em] text-slate-500 sm:px-5">
            <span>{t('nifi.kafka.property')}</span><span>{t('nifi.kafka.value')}</span>
          </div>
          <div class="config-row"><code>Kafka Connection Service</code><span>Kafka3ConnectionService</span></div>
          <div class="config-row"><code>Topics</code><span>nifi-events</span></div>
          <div class="config-row"><code>Group ID</code><span>nifi-consumers</span></div>
          <div class="config-row"><code>Processing Strategy</code><span>RECORD</span></div>
        </div>

        <div class="callout mt-8">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M4 6h16M4 12h10M4 18h7"></path></svg>
          <div><h3>{t('nifi.kafka.deliveryTitle')}</h3><p>{t('nifi.kafka.delivery')}</p></div>
        </div>
      </section>

      <section id="production" class="article-section">
        <p class="section-index">05 · {t('nifi.nav.production')}</p>
        <h2>{t('nifi.production.title')}</h2>
        <p>{t('nifi.production.p1')}</p>
        <div class="mt-8 grid gap-4 sm:grid-cols-2">
          <div class="check-card"><span>✓</span><div><h3>{t('nifi.production.backpressureTitle')}</h3><p>{t('nifi.production.backpressure')}</p></div></div>
          <div class="check-card"><span>✓</span><div><h3>{t('nifi.production.provenanceTitle')}</h3><p>{t('nifi.production.provenance')}</p></div></div>
          <div class="check-card"><span>✓</span><div><h3>{t('nifi.production.parametersTitle')}</h3><p>{t('nifi.production.parameters')}</p></div></div>
          <div class="check-card"><span>✓</span><div><h3>{t('nifi.production.failureTitle')}</h3><p>{t('nifi.production.failure')}</p></div></div>
        </div>
        <div class="mt-10 rounded-3xl border border-primary-custom/20 bg-primary-custom/[0.06] p-6 sm:p-8">
          <p class="font-headline text-xl font-bold text-slate-100">{t('nifi.conclusion.title')}</p>
          <p class="mt-3 text-sm leading-7 text-slate-400 sm:text-base">{t('nifi.conclusion.p1')}</p>
        </div>
      </section>

      <section aria-labelledby="sources-heading" class="border-t border-white/10 pt-10">
        <p class="section-index">{t('nifi.sources.eyebrow')}</p>
        <h2 id="sources-heading" class="mt-3 font-headline text-2xl font-bold text-slate-100">{t('nifi.sources.title')}</h2>
        <p class="mt-3 text-sm leading-7 text-slate-500">{t('nifi.sources.description')}</p>
        <div class="mt-6 flex flex-wrap gap-3">
          {sources.map((source) => (
            <a href={source.href} target="_blank" rel="noreferrer" class:list={['source-badge', toneClass[source.tone as keyof typeof toneClass]]}>
              <span class="h-1.5 w-1.5 rounded-full bg-current" aria-hidden="true"></span>
              {source.label}
              <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M14 5h5v5M10 14 19 5M19 14v5H5V5h5"></path></svg>
              <span class="sr-only"> ({t('nifi.sources.newTab')})</span>
            </a>
          ))}
        </div>
      </section>
    </div>

    <aside class="hidden self-start lg:sticky lg:top-28 lg:block" aria-label={t('nifi.onThisPage')}>
      <p class="font-mono text-[0.66rem] uppercase tracking-[0.12em] text-slate-500">{t('nifi.onThisPage')}</p>
      <nav class="mt-4 border-l border-white/10">
        <a class="side-link" href="#mental-model">01 · {t('nifi.nav.model')}</a>
        <a class="side-link" href="#start">02 · {t('nifi.nav.start')}</a>
        <a class="side-link" href="#flow">03 · {t('nifi.nav.flow')}</a>
        <a class="side-link" href="#kafka">04 · Kafka</a>
        <a class="side-link" href="#production">05 · {t('nifi.nav.production')}</a>
      </nav>
      <div class="mt-8 rounded-2xl border border-white/10 bg-white/[0.025] p-4">
        <p class="font-mono text-[0.64rem] uppercase tracking-[0.1em] text-slate-500">{t('nifi.stack')}</p>
        <div class="mt-3 flex flex-wrap gap-2">
          <span class="mini-badge">NiFi 2</span><span class="mini-badge">Kafka 4</span><span class="mini-badge">KRaft</span>
        </div>
      </div>
    </aside>
  </div>
</article>

<CopyCodeBehavior />
