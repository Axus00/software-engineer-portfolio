---
interface Props {
  command: string;
  label?: string;
  copyLabel: string;
  copiedLabel: string;
}

const { command, label = 'terminal', copyLabel, copiedLabel } = Astro.props;
---

<div class="terminal overflow-hidden rounded-2xl border border-white/10 bg-[#090c11] shadow-2xl shadow-black/25">
  <div class="flex items-center justify-between gap-4 border-b border-white/10 bg-white/[0.035] px-4 py-3">
    <div class="flex items-center gap-3">
      <span class="flex gap-1.5" aria-hidden="true">
        <span class="h-2.5 w-2.5 rounded-full bg-[#ff5f57]"></span>
        <span class="h-2.5 w-2.5 rounded-full bg-[#febc2e]"></span>
        <span class="h-2.5 w-2.5 rounded-full bg-[#28c840]"></span>
      </span>
      <span class="font-mono text-[0.68rem] uppercase tracking-[0.14em] text-slate-500">{label}</span>
    </div>
    <button
      type="button"
      class="copy-button inline-flex min-h-9 items-center gap-2 rounded-lg border border-white/10 px-3 py-1.5 font-mono text-[0.68rem] uppercase tracking-[0.08em] text-slate-400 transition hover:border-secondary-custom/40 hover:bg-secondary-custom/10 hover:text-secondary-custom focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-secondary-custom"
      data-terminal-copy
      data-copy-label={copyLabel}
      data-copied-label={copiedLabel}
      aria-label={copyLabel}
    >
      <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
        <rect x="9" y="9" width="11" height="11" rx="2"></rect>
        <path d="M15 9V6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v7a2 2 0 0 0 2 2h3"></path>
      </svg>
      <span data-copy-text>{copyLabel}</span>
    </button>
  </div>
  <pre class="overflow-x-auto p-4 text-[0.78rem] leading-6 text-slate-300 sm:p-5 sm:text-sm"><code data-command>{command}</code></pre>
  <span class="sr-only" aria-live="polite" data-copy-status></span>
</div>

