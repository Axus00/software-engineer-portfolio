---
const footerData = {
  name: "Fer.Dev",
  description: "Fernando Gómez, Software Engineer.",
  socialLinks: [
    {"name": "LinkedIn", "url": "https://www.linkedin.com/in/fernando-gomez-toro/"},
    {"name": "Github", "url": "https://github.com/Axus00"}
  ]
}
---

<footer class="w-full py-12 px-8 mt-24 bg-slate-950 border-t border-white/5">
    <div class="flex flex-col md:flex-row justify-between items-center max-w-7xl mx-auto gap-6">
      <div class="font-headline font-bold text-slate-300 text-lg">{footerData.name}</div>
      <p class="font-sans text-sm text-slate-500">&copy; 2026 {footerData.description}</p>
      <div class="flex gap-8 font-sans text-sm">
        {footerData.socialLinks.map((link) => 
          <a href={link.url} class="text-slate-500 hover:text-slate-100 transition-colors">{link.name}</a>
        )}
      </div>
    </div>
</footer>