---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Architect.dev | Senior Software Engineer Portfolio',
  description = 'Senior Software Architect specializing in distributed systems, high-performance neural engines, and clean-code architectures.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#10131a" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
