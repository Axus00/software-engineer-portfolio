---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Fer.dev | Software Engineer',
  description = 'Desarrollador Full Stack e IA que construye productos web y agentes LLM escalables, aplicando arquitectura limpia y microservicios para optimizar procesos e impulsar resultados de negocio.',
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#10131a" />
    <link rel="icon" href="/shared/resources/logos/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" href="/shared/resources/logos/favicon-32x32.png" sizes="32x32" />
    <link rel="icon" type="image/png" href="/shared/resources/logos/favicon-16x16.png" sizes="16x16" />
    <link rel="apple-touch-icon" href="/shared/resources/logos/apple-touch-icon.png" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
