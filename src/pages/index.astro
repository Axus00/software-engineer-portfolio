---
import Aside from '../components/Aside.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import LaboralExperience from '../components/LaboralExperience.astro';
import Layout from '../layouts/Layout.astro';
import ProfessionalPresence from '../components/ProfessionalPresence.astro';
import ProjectsCarouselBehavior from '../components/behaviors/ProjectsCarouselBehavior.astro';
import Projects from '../components/Projects.astro';
import ScrollBehavior from '../components/behaviors/ScrollBehavior.astro';
import Trust from '../components/Trust.astro';
import Messages from '../components/Messages.astro';
import ExpandedBehavior from '../components/behaviors/ExpandedBehavior.astro';
import OpenChatBehavior from '../components/behaviors/OpenChatBehavior.astro';
import AiButton from '../components/AiButton.astro';
---

<Layout>
  <Aside />
  <Header />
  <main class="min-h-screen font-sans selection:bg-primary-custom/30 selection:text-primary-custom">
    <Hero />
    <Trust />
    <Messages />
    <LaboralExperience />
    <Projects />
    <ProfessionalPresence />
    <Contact />
  </main>
  <Footer />
  <ScrollBehavior />
  <ProjectsCarouselBehavior />
  <ExpandedBehavior />
  <AiButton />
  <OpenChatBehavior />
</Layout>
