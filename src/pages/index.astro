---
import BaseLayout from '../layouts/BaseLayout.astro';

const logos = ['Meta', 'Stripe', 'Uber', 'Google', 'Amazon', 'Netflix', 'Apple', 'Microsoft'];

const experiences = [
  {
    role: 'Principal Systems Engineer',
    company: 'Meta',
    period: '2021 - PRESENT',
    description:
      'Leading the infrastructure scaling for real-time data processing engines. Architected a distributed caching layer that reduced latency by 40% across global clusters.',
    tag: 'ACTUALMENTE',
    subItems: [{ label: 'STAFFING PARTNER', content: 'CloudScale Solutions - Infrastructure Support' }],
  },
  {
    role: 'Staff Software Engineer',
    company: 'Stripe',
    period: '2018 - 2021',
    description:
      'Spearheaded the integration of multi-currency settlement systems. Optimized transaction throughput for high-frequency trading API endpoints.',
    subItems: [{ label: 'CLIENT PROJECT', content: 'FinTech Systems - Payment Gateway Migration' }],
  },
  {
    role: 'Senior Full-Stack Developer',
    company: 'Uber',
    period: '2015 - 2018',
    description:
      'Focused on geospatial optimization algorithms and mobile-first driver experiences using React Native and Go.',
    subItems: [{ label: 'INTERNAL VENTURE', content: 'Mobility Lab - Autonomous Routing Beta' }],
  },
];

const projects = [
  {
    title: 'Quantum Ledger',
    description:
      'A decentralized cryptographic ledger utilizing lattice-based encryption to secure transactions against quantum computational threats.',
    tags: ['Rust', 'WebAssembly', 'JS'],
    image: 'https://picsum.photos/seed/quantum/800/600',
  },
  {
    title: 'Neural Sync Engine',
    description:
      'Real-time synchronization layer for distributed AI agents, optimizing inference loads across edge computing nodes using predictive modeling.',
    tags: ['PyTorch', 'Go', 'React'],
    image: 'https://picsum.photos/seed/neural/800/600',
  },
];
---

<BaseLayout>
  <aside class="fixed left-0 top-0 bottom-0 w-12 z-40 flex flex-col items-center justify-center pointer-events-none">
    <div class="relative h-1/2 w-px bg-white/5">
      <div id="spine-progress" class="absolute top-0 left-1/2 -translate-x-1/2 w-0.5 h-full bg-linear-to-b from-secondary-custom to-secondary-custom shadow-[0_0_18px_rgba(64,229,108,0.65)] origin-top"></div>
      <div class="absolute inset-0 flex flex-col justify-around py-8">
        {Array.from({ length: 4 }).map(() => (
          <div class="relative flex items-center justify-center">
            <div class="w-1.5 h-1.5 rounded-full bg-surface border border-white/20 z-10"></div>
          </div>
        ))}
      </div>
    </div>
  </aside>

  <nav id="main-nav" class="fixed top-6 left-1/2 -translate-x-1/2 w-[90%] max-w-4xl z-50 rounded-full transition-all duration-300 bg-transparent py-4 px-2">
    <div class="flex justify-between items-center w-full">
      <div class="text-lg font-bold text-slate-100 font-headline tracking-tight">Architect.dev</div>
      <div class="hidden md:flex items-center gap-8 font-headline tracking-tight font-medium text-sm">
        <a href="#experience" class="text-slate-400 hover:text-primary-custom transition-colors">Experience</a>
        <a href="#projects" class="text-slate-400 hover:text-primary-custom transition-colors">Projects</a>
        <a href="#stack" class="text-slate-400 hover:text-primary-custom transition-colors">Connect</a>
        <a href="#contact" class="text-slate-400 hover:text-primary-custom transition-colors">Contact</a>
      </div>
      <button aria-label="Toggle theme" class="text-slate-400 hover:text-primary-custom transition-transform active:scale-90">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9"/></svg>
      </button>
    </div>
  </nav>

  <main class="min-h-screen font-sans selection:bg-primary-custom/30 selection:text-primary-custom">
    <section class="relative min-h-screen flex flex-col justify-center items-center px-6 overflow-hidden">
      <div class="absolute inset-0 z-0 opacity-20 pointer-events-none">
        <div class="absolute top-1/4 left-1/4 w-96 h-96 bg-blue-600/30 blur-[120px] rounded-full"></div>
        <div class="absolute bottom-1/4 right-1/4 w-96 h-96 bg-emerald-600/30 blur-[120px] rounded-full"></div>
      </div>
      <div class="relative z-10 max-w-4xl text-center reveal is-visible">
        <h1 class="font-headline text-5xl md:text-7xl font-extrabold tracking-tight mb-6 leading-tight">
          Engineering <span class="text-gradient">Digital Resilience</span> and Technical Mastery.
        </h1>
        <p class="font-sans text-lg md:text-xl text-slate-400 max-w-2xl mx-auto mb-10 leading-relaxed">
          Senior Software Architect specializing in distributed systems, high-performance neural engines, and clean-code architectures.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href="#projects" class="px-8 py-4 rounded-full bg-blue-600 text-white font-semibold text-lg shadow-lg shadow-blue-600/20 hover:scale-105 active:scale-95 transition-all">
            Explore My Projects
          </a>
          <a href="#contact" class="px-8 py-4 rounded-full bg-transparent border border-white/10 backdrop-blur-md text-white font-semibold text-lg hover:bg-white/5 transition-all">
            Get In Touch
          </a>
        </div>
      </div>
    </section>

    <section class="py-24 px-8 bg-surface-container-low/30 border-y border-white/5">
      <div class="max-w-7xl mx-auto text-center">
        <h2 class="font-sans text-xs uppercase tracking-[0.2em] text-slate-500 mb-16">Trusted by Industry Leaders</h2>
        <div class="relative overflow-hidden">
          <div class="absolute inset-y-0 left-0 w-32 bg-linear-to-r from-surface to-transparent z-10 pointer-events-none"></div>
          <div class="absolute inset-y-0 right-0 w-32 bg-linear-to-l from-surface to-transparent z-10 pointer-events-none"></div>
          <div class="logo-carousel-track flex gap-12 items-center">
            {[...logos, ...logos].map((logo) => (
              <div class="flex items-center gap-2 text-slate-600 font-headline font-bold text-2xl grayscale hover:grayscale-0 transition-all cursor-pointer opacity-50 hover:opacity-100">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary-custom"><path d="M12 3v18"/><path d="m3 12 18 0"/></svg>
                {logo}
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section id="experience" class="py-32 px-8">
      <div class="max-w-5xl mx-auto">
        <h2 class="font-headline text-3xl font-bold mb-16 text-white">Experience Spine</h2>
        <div class="relative space-y-16 pb-8">
          <div class="absolute left-6 top-2 bottom-0 w-px bg-white/5"></div>
          <div id="experience-progress" class="absolute left-6 top-2 bottom-0 w-0.5 -ml-[0.5px] bg-linear-to-b from-secondary-custom to-secondary-custom origin-top shadow-[0_0_14px_rgba(64,229,108,0.6)] z-0"></div>

          {experiences.map((exp) => (
            <article class="relative pl-16 group reveal">
              <div class="absolute left-0 top-1 w-12 h-12 bg-surface-container rounded-lg border border-white/5 flex items-center justify-center z-10 group-hover:border-primary-custom/50 transition-colors">
                <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary-custom"><path d="m9 12 2 2 4-4"/><path d="M21 12c.552 0 1.005-.449.95-.998A10 10 0 1 0 12 21.95c.549.055.998-.398.998-.95 0-.552-.449-.998-.998-1.004A8 8 0 1 1 20 12c0 .551.446 1 1 1Z"/></svg>
              </div>
              <div class="flex flex-col md:flex-row md:items-center justify-between mb-2">
                <h3 class="font-headline text-xl font-bold text-white">{exp.role}</h3>
                <span class="font-sans text-sm text-slate-500">{exp.period}</span>
              </div>
              <div class="flex items-center gap-3 mb-4">
                <span class="font-medium text-primary-custom">{exp.company}</span>
                {exp.tag && (
                  <span class="px-3 py-1 bg-emerald-500/10 text-emerald-500 text-[10px] uppercase tracking-wider font-bold rounded-full border border-emerald-500/20">
                    {exp.tag}
                  </span>
                )}
              </div>
              <p class="text-slate-400 leading-relaxed max-w-3xl">{exp.description}</p>

              <div class="mt-6 ml-4 relative">
                <div class="absolute left-0 top-0 bottom-0 w-px border-l border-dashed border-white/10"></div>
                {exp.subItems.map((sub) => (
                  <div class="relative pl-8 pb-4">
                    <div class="absolute left-[-4.5px] top-1.5 w-2 h-2 rounded-full bg-slate-700 border border-surface"></div>
                    <div class="flex flex-col">
                      <span class="text-[10px] font-bold text-slate-500 uppercase tracking-widest">{sub.label}</span>
                      <span class="text-sm text-slate-300">{sub.content}</span>
                    </div>
                  </div>
                ))}
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section id="projects" class="py-32 px-8 bg-surface-container-low/20">
      <div class="max-w-7xl mx-auto">
        <div class="flex justify-between items-end mb-16">
          <div>
            <h2 class="font-headline text-4xl font-extrabold mb-4">Neural Architectures</h2>
            <p class="text-slate-500">High-end implementations of complex logic.</p>
          </div>
          <a href="#" class="hidden md:flex items-center gap-2 text-primary-custom font-semibold hover:gap-4 transition-all">View Archive</a>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          {projects.map((project) => (
            <article class="project-card group relative bg-surface-container-low rounded-xl overflow-hidden shadow-xl shadow-black/20 border border-white/5 reveal">
              <div class="h-64 overflow-hidden">
                <img src={project.image} alt={project.title} class="project-image w-full h-full object-cover transition-transform duration-700" loading="lazy" referrerpolicy="no-referrer" />
              </div>
              <div class="p-8">
                <h3 class="font-headline text-2xl font-bold text-white mb-4">{project.title}</h3>
                <p class="text-slate-400 mb-8 leading-relaxed">{project.description}</p>
                <div class="flex flex-wrap gap-3 mb-8">
                  {project.tags.map((tag) => (
                    <span class="px-3 py-1.5 bg-surface-container-high rounded-lg text-xs font-medium text-slate-300">{tag}</span>
                  ))}
                </div>
                <div class="flex justify-between items-center border-t border-white/5 pt-6">
                  <button class="flex items-center gap-2 text-sm font-semibold hover:text-primary-custom transition-colors text-white">Live Demo</button>
                  <a href="#" class="flex items-center gap-2 text-sm font-semibold text-slate-500 hover:text-white transition-colors">Repository</a>
                </div>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section id="stack" class="py-32 px-8">
      <div class="max-w-7xl mx-auto grid grid-cols-1 md:grid-cols-2 gap-8">
        <article class="group relative flex flex-col items-center justify-center p-12 bg-white/5 backdrop-blur-xl rounded-3xl border border-white/10 hover:border-primary-custom/40 transition-all duration-500 overflow-hidden text-center shadow-2xl reveal">
          <div class="absolute inset-0 bg-linear-to-br from-primary-custom/5 to-transparent opacity-0 group-hover:opacity-100 transition-opacity"></div>
          <div class="relative z-10">
            <h2 class="font-headline text-4xl font-extrabold mb-6 text-white">Open Source Craft</h2>
            <p class="text-xl text-slate-400 mb-10 max-w-sm mx-auto">Exploring the frontiers of engineering through shared knowledge and code.</p>
            <button class="px-10 py-5 bg-white text-surface font-bold text-lg rounded-full hover:scale-105 active:scale-95 transition-all shadow-xl">Explore My Code</button>
          </div>
        </article>

        <article class="group relative flex flex-col items-center justify-center p-12 bg-white/5 backdrop-blur-xl rounded-3xl border border-white/10 hover:border-secondary-custom/40 transition-all duration-500 overflow-hidden text-center shadow-2xl reveal">
          <div class="absolute inset-0 bg-linear-to-br from-secondary-custom/5 to-transparent opacity-0 group-hover:opacity-100 transition-opacity"></div>
          <div class="relative z-10">
            <h2 class="font-headline text-4xl font-extrabold mb-6 text-white">Professional Network</h2>
            <p class="text-xl text-slate-400 mb-10 max-w-sm mx-auto">Cultivating strategic partnerships and technical leadership globally.</p>
            <button class="px-10 py-5 bg-white text-surface font-bold text-lg rounded-full hover:scale-105 active:scale-95 transition-all shadow-xl">Let's Connect</button>
          </div>
        </article>
      </div>
    </section>

    <section id="contact" class="py-32 px-8">
      <div class="max-w-4xl mx-auto rounded-[2rem] bg-linear-to-br from-primary-custom/10 to-secondary-custom/10 p-12 text-center border border-white/5 reveal">
        <h2 class="font-headline text-4xl md:text-5xl font-extrabold mb-8 text-white">Ready to architect the future?</h2>
        <p class="text-xl text-slate-400 mb-10">Currently open for senior roles and consulting for high-impact projects.</p>
        <button class="px-10 py-5 bg-white text-surface font-bold text-lg rounded-full hover:scale-105 active:scale-95 transition-all">Initiate Connection</button>
      </div>
    </section>
  </main>

  <footer class="w-full py-12 px-8 mt-24 bg-slate-950 border-t border-white/5">
    <div class="flex flex-col md:flex-row justify-between items-center max-w-7xl mx-auto gap-6">
      <div class="font-headline font-bold text-slate-300 text-lg">Architect.dev</div>
      <p class="font-sans text-sm text-slate-500">&copy; 2026 Obsidian Engineering. Built with Precision.</p>
      <div class="flex gap-8 font-sans text-sm">
        <a href="#" class="text-slate-500 hover:text-slate-100 transition-colors">LinkedIn</a>
        <a href="#" class="text-slate-500 hover:text-slate-100 transition-colors">GitHub</a>
        <a href="#" class="text-slate-500 hover:text-slate-100 transition-colors">Twitter</a>
      </div>
    </div>
  </footer>

  <script>
    const nav = document.getElementById('main-nav');
    const spine = document.getElementById('spine-progress');
    const expSpine = document.getElementById('experience-progress');

    const onScroll = () => {
      const y = window.scrollY || 0;
      if (nav) {
        const scrolled = y > 50;
        nav.classList.toggle('glass-nav', scrolled);
        nav.classList.toggle('shadow-2xl', scrolled);
        nav.classList.toggle('py-3', scrolled);
        nav.classList.toggle('px-6', scrolled);
        nav.classList.toggle('py-4', !scrolled);
        nav.classList.toggle('px-2', !scrolled);
      }

      const h = document.documentElement;
      const max = h.scrollHeight - h.clientHeight;
      const ratio = max > 0 ? y / max : 0;
      if (spine) spine.style.scale = `1 ${Math.min(1, Math.max(0, ratio))}`;

      const exp = document.getElementById('experience');
      if (expSpine && exp) {
        const rect = exp.getBoundingClientRect();
        const vh = window.innerHeight;
        const progress = (vh - rect.top) / (rect.height + vh * 0.3);
        expSpine.style.scale = `1 ${Math.min(1, Math.max(0, progress))}`;
      }
    };

    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
          }
        }
      },
      { threshold: 0.15 }
    );

    document.querySelectorAll('.reveal').forEach((el) => observer.observe(el));
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll, { passive: true });
    window.addEventListener('load', onScroll, { once: true });
    onScroll();
  </script>
</BaseLayout>
